    characterSetSelectionMode: 7
    characterSequence: "\u3053\u308C\u306F\u30D5\u30A3\u30AF\u30B7\u30E7\u30F3\u4F5C\u54C1\u3067\u3059\u3002\r\n\u76EE\u7684\u5730\u306B\u5230\u7740\u3059\u308B\u3002\r\n\u3042\u306A\u305F\u306F\u6B7B\u306B\u307E\u3057\u305F\u3002\r\n\"\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\u76EE\u7684\u5730\u306B\u5230\u7740\u3057\u307E\u3057\u305F\uFF01\nVR\u3092\u901A\u3058\u3066\u3001\u5B89\u5168\u306A\u74B0\u5883\u3067\u30C9\u30ED\u30FC\u30F3\u6226\u4E89\u304C\u3069\u306E\u3088\u3046\u306A\u3082\u306E\u304B\u4F53\u9A13\u3057\u305F\u3044\u3068\u601D\u3044\u3001\u3053\u306EVRChat\u30EF\u30FC\u30EB\u30C9\u3092\u4F5C\u308A\u307E\u3057\u305F\u3002\n\u5168\u4F53\u3068\u3057\u3066\u3001\u30C9\u30ED\u30FC\u30F3\u6226\u4E89\u306F\u5730\u7344\u3060\u3068\u601D\u3044\u307E\u3059\u3002\u3068\u306F\u3044\u3048\u3001\u6226\u4E89\u305D\u306E\u3082\u306E\u304C\u5730\u7344\u306A\u306E\u3067\u3059\u3002\n\"\r\n\"\u30A6\u30AF\u30E9\u30A4\u30CA\u306B\u306F\u3001\u4ED6\u306E\u3069\u306E\u56FD\u3068\u540C\u3058\u3088\u3046\u306B\u6B20\u70B9\u3082\u3042\u308A\u307E\u3059\u304C\u3001\u305D\u308C\u306F\u4FB5\u7565\u3092\u6B63\u5F53\u5316\u3059\u308B\u3082\u306E\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002 
      \n\u6B8B\u5FF5\u306A\u304C\u3089\u3001\u6226\u4E89\u306F\u653F\u6CBB\u306E\u5EF6\u9577\u3067\u3042\u308A\u3001\u3057\u3070\u3057\u3070\u4EA4\u6E09\u306E\u5931\u6557\u306B\u3088\u3063\u3066\u5F15\u304D\u8D77\u3053\u3055\u308C\u307E\u3059\u3002 
      \n\u79C1\u306E\u4E16\u754C\u3092\u4F53\u9A13\u3057\u3066\u304F\u3060\u3055\u3063\u3066\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002 
      \n\u5E73\u548C\u3092\u9858\u3063\u3066\u3044\u307E\u3059\u3002\"\r\n\"\u30ED\u30B7\u30A2\u306B\u3088\u308B\u30A6\u30AF\u30E9\u30A4\u30CA\u4FB5\u653B\u3067\u306F\u3001\u53CC\u65B9\u304C\u591A\u304F\u306E\u7A2E\u985E\u306E\u30C9\u30ED\u30FC\u30F3\u3092\u4F7F\u7528\u3057\u3066\u3044\u307E\u3059\u3002 
      \n\u7279\u306B\u6CE8\u76EE\u3059\u3079\u304D\u306A\u306E\u306F\u3001FPV\u30AB\u30DF\u30AB\u30BC\u30C9\u30ED\u30FC\u30F3\u3068\u7206\u6483\u30C9\u30ED\u30FC\u30F3\u3067\u3059\u3002 
      \n\u3053\u306E\u30DE\u30C3\u30D7\u3067\u306F\u30018\u30A4\u30F3\u30C1\u306EFPV\u30AB\u30DF\u30AB\u30BC\u30C9\u30ED\u30FC\u30F3\uFF08\u79C1\u306F\u300CChaser\u300D\u3068\u547C\u3093\u3067\u3044\u307E\u3059\uFF09\u3068\u300110\u30A4\u30F3\u30C1\u306E\u7206\u6483\u30C9\u30ED\u30FC\u30F3\uFF08\u300CDropper\u300D\uFF09\u3092\u30E2\u30C7\u30EB\u5316\u3057\u307E\u3057\u305F\u3002\u79C1\u304C\u4F7F\u7528\u3057\u3066\u3044\u308B\u56FA\u5B9A\u7FFC\u5075\u5BDF\u30C9\u30ED\u30FC\u30F3\uFF08\u300CSpotter\u300D\uFF09\u306F\u3001\u5358\u7D14\u306A\u7BB1\u3067\u4F5C\u3063\u305F\u3082\u306E\u3067\u3059\u3002 
      \n\u3055\u3089\u306B\u3001\u5F85\u3061\u4F0F\u305B\u3059\u308B\u30C9\u30ED\u30FC\u30F3\uFF08\u300CWaiter\u300D\uFF09\u3001\u56FA\u5B9A\u7FFC\u30AB\u30DF\u30AB\u30BC\u30C9\u30ED\u30FC\u30F3\uFF08\u300CCrasher\u300D\uFF09\u3001\u30AF\u30A2\u30C3\u30C9\u30B3\u30D7\u30BF\u30FC\u5075\u5BDF\u30C9\u30ED\u30FC\u30F3\uFF08\u300CFloater\u300D\uFF09\u306A\u3069\u3001\u3088\u308A\u591A\u304F\u306E\u7A2E\u985E\u306E\u30C9\u30ED\u30FC\u30F3\u3092\u8FFD\u52A0\u3057\u3088\u3046\u3068\u8003\u3048\u3066\u3044\u307E\u3059\u3002 
      \n\u305F\u3060\u3057\u3001VRChat\u3067\u51E6\u7406\u3067\u304D\u308B\u304B\u3069\u3046\u304B\u306F\u5206\u304B\u308A\u307E\u305B\u3093\u3002 
      \n\u3061\u306A\u307F\u306B\u3001\u5B9F\u6226\u3067\u4F7F\u7528\u3055\u308C\u308B\u30C9\u30ED\u30FC\u30F3\u306F\u3001\u3088\u308A\u901F\u304F\u98DB\u884C\u3057\u307E\u3059\u3002\"\r\n\"\u5F53\u521D\u3001\u30DE\u30C3\u30D7\u306E\u30B5\u30A4\u30BA\u306F500\xD7500m\u3067\u3057\u305F\u304C\u3001\u5927\u304D\u3059\u304E\u308B\u3068\u6C17\u3065\u3044\u305F\u305F\u3081\u3001\u73FE\u5728\u306F100\xD7100m\u306B\u306A\u3063\u3066\u3044\u307E\u3059\u3002\n\u3053\u306E\u30DE\u30C3\u30D7\u306B\u306F\u3001\u5879\u58D5\u3084\u5BB6\u5C4B\u3001\u7834\u58CA\u3055\u308C\u305F\u8ECA\u4E21\u306A\u3069\u3001\u3055\u3089\u306B\u591A\u304F\u306E\u5730\u5F62\u8981\u7D20\u3092\u8FFD\u52A0\u3057\u305F\u3044\u3068\u601D\u3063\u3066\u3044\u307E\u3057\u305F\u3002\n\u3057\u304B\u3057\u3001\u3053\u306E\u30DE\u30C3\u30D7\u306B\u9069\u3057\u305F\u7121\u6599\u306E\u30E2\u30C7\u30EB\u3092\u898B\u3064\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\u3002\n\u3053\u306E\u30DE\u30C3\u30D7\u306F\u4E0D\u6B63\u3092\u3057\u307E\u305B\u3093\u3002\u653B\u6483\u7528\u30C9\u30ED\u30FC\u30F3\u304C\u5C55\u958B\u3055\u308C\u308B\u524D\u306B\u3001\u307E\u305A\u30C9\u30ED\u30FC\u30F3\u304C\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u767A\u898B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002AI\u306F\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u4F4D\u7F6E\u3092\u628A\u63E1\u3057\u3066\u3044\u307E\u305B\u3093\u3002AI\u306F\u73FE\u5B9F\u7684\u306B\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u635C\u7D22\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\n\n\u6700\u5F8C\u306B\u3001\u79C1\u306FClaude
      AI\u3092\u4F7F\u3063\u305F\u30D0\u30A4\u30D6\u30B3\u30FC\u30C7\u30A3\u30F3\u30B0\u304C\u5927\u597D\u304D\u3067\u3059\u3002\""
