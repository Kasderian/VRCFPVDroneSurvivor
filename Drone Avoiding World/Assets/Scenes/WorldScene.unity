  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0423\u043A\u0440\u0430\u0438\u043D\u0430, \u043A\u0430\u043A \u0438
    \u043B\u044E\u0431\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u0430, \u0438\u043C\u0435\u0435\u0442
    \u0441\u0432\u043E\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438,
    \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u0435\u0442
    \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435 \u0432 \u043D\u0435\u0451. 
    \n\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0432\u043E\u0439\u043D\u0430
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435\u043C
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0438 \u0438 \u0447\u0430\u0441\u0442\u043E
    \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u0438\u0437-\u0437\u0430
    \u043F\u0440\u043E\u0432\u0430\u043B\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432. 
    \n\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0432\u044B
    \u0441\u043E\u043F\u0440\u0438\u043A\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C
    \u0441 \u043C\u043E\u0438\u043C \u043C\u0438\u0440\u043E\u043C.  \n\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C
    \u043D\u0430 \u043C\u0438\u0440."
