--- !u!114 &1237068014
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1237068012}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0406\u0441\u043D\u0443\u0454 \u0431\u0430\u0433\u0430\u0442\u043E \u0442\u0438\u043F\u0456\u0432
    \u0434\u0440\u043E\u043D\u0456\u0432, \u044F\u043A\u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
    \u043E\u0431\u0438\u0434\u0432\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438
    \u043F\u0456\u0434 \u0447\u0430\u0441 \u0440\u043E\u0441\u0456\u0439\u0441\u044C\u043A\u043E\u0433\u043E
    \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F \u0432 \u0423\u043A\u0440\u0430\u0457\u043D\u0443.\n\u041D\u0430\u0439\u043F\u043E\u043C\u0456\u0442\u043D\u0456\u0448\u0438\u043C\u0438
    \u0454 FPV-\u0434\u0440\u043E\u043D\u0438-\u043A\u0430\u043C\u0456\u043A\u0430\u0434\u0437\u0435
    \u0442\u0430 \u0434\u0440\u043E\u043D\u0438-\u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A\u0438.\n\u041D\u0430
    \u0446\u0456\u0439 \u043A\u0430\u0440\u0442\u0456 \u044F \u0437\u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u0432
    8-\u0434\u044E\u0439\u043C\u043E\u0432\u0438\u0439 FPV-\u0434\u0440\u043E\u043D-\u043A\u0430\u043C\u0456\u043A\u0430\u0434\u0437\u0435
    (\u044F \u043D\u0430\u0437\u0438\u0432\u0430\u044E \u0439\u043E\u0433\u043E Chaser)
    \u0456 10-\u0434\u044E\u0439\u043C\u043E\u0432\u0438\u0439 \u0434\u0440\u043E\u043D-\u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u043A
    (Dropper). \u0411\u0435\u0437\u043F\u0456\u043B\u043E\u0442\u043D\u0438\u043A-\u0440\u043E\u0437\u0432\u0456\u0434\u043D\u0438\u043A
    \u0456\u0437 \u0444\u0456\u043A\u0441\u043E\u0432\u0430\u043D\u0438\u043C \u043A\u0440\u0438\u043B\u043E\u043C
    (Spotter), \u044F\u043A\u043E\u0433\u043E \u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E,
    \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u043B\u0438\u0448\u0435
    \u0437 \u043F\u0440\u043E\u0441\u0442\u0438\u0445 \u0431\u043B\u043E\u043A\u0456\u0432.\n\u042F
    \u0434\u0443\u043C\u0430\u044E \u0434\u043E\u0434\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
    \u0442\u0438\u043F\u0456\u0432 \u0434\u0440\u043E\u043D\u0456\u0432: \u0434\u0440\u043E\u043D\u0438,
    \u044F\u043A\u0456 \u043E\u0447\u0456\u043A\u0443\u044E\u0442\u044C \u0443 \u0437\u0430\u0441\u0456\u0434\u0446\u0456
    (Waiter), \u0434\u0440\u043E\u043D\u0438-\u043A\u0430\u043C\u0456\u043A\u0430\u0434\u0437\u0435
    \u0437 \u0444\u0456\u043A\u0441\u043E\u0432\u0430\u043D\u0438\u043C \u043A\u0440\u0438\u043B\u043E\u043C
    (Crasher) \u0456 \u0440\u043E\u0437\u0432\u0456\u0434\u0443\u0432\u0430\u043B\u044C\u043D\u0438\u0439
    \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440 (Floater).\n\u041E\u0434\u043D\u0430\u043A
    \u044F \u043D\u0435 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0438\u0439, \u0447\u0438
    \u0432\u043F\u043E\u0440\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u0446\u0438\u043C
    VRChat.\n\u0414\u043E \u0440\u0435\u0447\u0456, \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456
    \u0434\u0440\u043E\u043D\u0438, \u044F\u043A\u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E\u0442\u044C
    \u0443 \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u0434\u0456\u044F\u0445, \u043B\u0456\u0442\u0430\u044E\u0442\u044C
    \u0448\u0432\u0438\u0434\u0448\u0435."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 42baf463103e4e8409b5b658a3383908, type: 2}
