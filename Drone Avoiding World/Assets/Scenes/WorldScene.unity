  m_text: "\u5728\u4FC4\u4E4C\u6218\u4E89\u4E2D\uFF0C\u53CC\u65B9\u90FD\u4F7F\u7528\u4E86\u591A\u79CD\u7C7B\u578B\u7684\u65E0\u4EBA\u673A\u3002\n\u5176\u4E2D\u6700\u5F15\u4EBA\u6CE8\u76EE\u7684\u65E0\u4EBA\u673A\u662F
    FPV \u81EA\u6740\u5F0F\u65E0\u4EBA\u673A\u548C\u8F70\u70B8\u65E0\u4EBA\u673A\u3002\n\u5728\u8FD9\u5F20\u5730\u56FE\u4E2D\uFF0C\u6211\u5236\u4F5C\u4E86\u4E00\u67B6
    8 \u82F1\u5BF8 FPV \u81EA\u6740\u5F0F\u65E0\u4EBA\u673A\uFF08\u6211\u79F0\u4E4B\u4E3A\u201C\u8FFD\u51FB\u8005\u201D\uFF09\u548C\u4E00\u67B6
    10 \u82F1\u5BF8\u8F70\u70B8\u65E0\u4EBA\u673A\uFF08\u201C\u6295\u5F39\u624B\u201D\uFF09\u3002\u6211\u4F7F\u7528\u7684\u56FA\u5B9A\u7FFC\u4FA6\u5BDF\u65E0\u4EBA\u673A\uFF08\u201C\u4FA6\u5BDF\u5458\u201D\uFF09\u53EA\u662F\u7528\u7B80\u5355\u7684\u65B9\u5757\u5236\u4F5C\u7684\u3002\n\u6211\u6B63\u5728\u8003\u8651\u6DFB\u52A0\u66F4\u591A\u7C7B\u578B\u7684\u65E0\u4EBA\u673A\uFF1A\u7B49\u5F85\u4F0F\u51FB\u7684\u65E0\u4EBA\u673A\uFF08\u201C\u4F0F\u51FB\u8005\u201D\uFF09\u3001\u56FA\u5B9A\u7FFC\u81EA\u6740\u5F0F\u65E0\u4EBA\u673A\uFF08\u201C\u649E\u51FB\u8005\u201D\uFF09\u4EE5\u53CA\u56DB\u65CB\u7FFC\u4FA6\u5BDF\u65E0\u4EBA\u673A\uFF08\u201C\u6F02\u6D6E\u8005\u201D\uFF09\u3002\n\u4E0D\u8FC7\uFF0C\u6211\u4E0D\u786E\u5B9A
    VRChat \u662F\u5426\u80FD\u591F\u627F\u8F7D\u8FD9\u4E9B\u5185\u5BB9\u3002\n\u987A\u4FBF\u8BF4\u4E00\u53E5\uFF0C\u73B0\u5B9E\u4E2D\u7528\u4E8E\u6218\u6597\u7684\u65E0\u4EBA\u673A\u98DE\u5F97\u66F4\u5FEB\u3002"
