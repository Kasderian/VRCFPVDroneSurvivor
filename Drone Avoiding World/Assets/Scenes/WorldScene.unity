--- !u!114 &526786007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 526786005}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB7EC\uC2DC\uC544\uC758 \uC6B0\uD06C\uB77C\uC774\uB098 \uCE68\uACF5\uC5D0\uC11C
    \uC591\uCE21\uC774 \uC0AC\uC6A9\uD558\uB294 \uB4DC\uB860\uC5D0\uB294 \uC5EC\uB7EC
    \uC885\uB958\uAC00 \uC788\uC2B5\uB2C8\uB2E4.  \n\uAC00\uC7A5 \uC8FC\uBAA9\uD560
    \uB9CC\uD55C \uB4DC\uB860\uC740 FPV \uC790\uD3ED \uB4DC\uB860\uACFC \uD3ED\uACA9
    \uB4DC\uB860\uC785\uB2C8\uB2E4.  \n\uC774 \uC9C0\uB3C4\uC5D0\uC11C\uB294 8\uC778\uCE58
    FPV \uC790\uD3ED \uB4DC\uB860(\uC81C\uAC00 \u2018\uCCB4\uC774\uC11C\u2019\uB77C\uACE0
    \uBD80\uB984)\uACFC 10\uC778\uCE58 \uD3ED\uACA9 \uB4DC\uB860(\u2018\uB4DC\uB85C\uD37C\u2019)\uC744
    \uBAA8\uB378\uB9C1\uD588\uC2B5\uB2C8\uB2E4. \uC81C\uAC00 \uC0AC\uC6A9\uD558\uB294
    \uACE0\uC815\uC775 \uC815\uCC30 \uB4DC\uB860(\u2018\uC2A4\uD3EC\uD130\u2019)\uC740
    \uB2E8\uC21C\uD55C \uC0C1\uC790 \uD615\uD0DC\uB85C\uB9CC \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. 
    \n\uCD94\uAC00\uB85C \uB9E4\uBCF5 \uB300\uAE30 \uB4DC\uB860(\u2018\uC6E8\uC774\uD130\u2019),
    \uACE0\uC815\uC775 \uC790\uD3ED \uB4DC\uB860(\u2018\uD06C\uB798\uC154\u2019),
    \uCFFC\uB4DC\uCF65\uD130 \uC815\uCC30 \uB4DC\uB860(\u2018\uD50C\uB85C\uD130\u2019)\uB3C4
    \uCD94\uAC00\uD560 \uC0DD\uAC01\uC785\uB2C8\uB2E4.  \n\uD558\uC9C0\uB9CC VRChat\uC774
    \uC774\uB97C \uAC10\uB2F9\uD560 \uC218 \uC788\uC744\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. 
    \n\uCC38\uACE0\uB85C \uC2E4\uC81C \uC804\uD22C\uC5D0 \uC0AC\uC6A9\uB418\uB294
    \uB4DC\uB860\uC740 \uB354 \uBE60\uB974\uAC8C \uBE44\uD589\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
