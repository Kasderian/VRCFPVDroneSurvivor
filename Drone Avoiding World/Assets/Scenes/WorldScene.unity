      m_Calls: []
  m_text: "\u0423\u043A\u0440\u0430\u0457\u043D\u0430, \u044F\u043A \u0456 \u0431\u0443\u0434\u044C-\u044F\u043A\u0430
    \u043A\u0440\u0430\u0457\u043D\u0430, \u043C\u0430\u0454 \u0441\u0432\u043E\u0457
    \u043D\u0435\u0434\u043E\u043B\u0456\u043A\u0438, \u0430\u043B\u0435 \u0446\u0435
    \u043D\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u0434\u043E\u0432\u0443\u0454
    \u0457\u0457 \u0432\u0442\u043E\u0440\u0433\u043D\u0435\u043D\u043D\u044F.\n\u041D\u0430
    \u0436\u0430\u043B\u044C, \u0432\u0456\u0439\u043D\u0430 \u0454 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F\u043C
    \u043F\u043E\u043B\u0456\u0442\u0438\u043A\u0438 \u0439 \u0447\u0430\u0441\u0442\u043E
    \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u044F\u0454\u0442\u044C\u0441\u044F
    \u043F\u0440\u043E\u0432\u0430\u043B\u043E\u043C \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0456\u0432.\n\u0414\u044F\u043A\u0443\u044E,
    \u0449\u043E \u043F\u0456\u0437\u043D\u0430\u0454\u0442\u0435 \u043C\u0456\u0439
    \u0441\u0432\u0456\u0442.\n\u042F \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F
    \u043D\u0430 \u043C\u0438\u0440."
  m_isRightToLeft: 0
