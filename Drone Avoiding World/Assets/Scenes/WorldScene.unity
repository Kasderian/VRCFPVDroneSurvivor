  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uCC98\uC74C\uC5D0\uB294 \uB9F5 \uD06C\uAE30\uAC00 500 x 500m\uC600\uC9C0\uB9CC,
    \uB108\uBB34 \uD074 \uAC83 \uAC19\uC544\uC11C \uD604\uC7AC\uB294 100 x 100m\uB85C
    \uC904\uC600\uC2B5\uB2C8\uB2E4.  \n\uC774 \uB9F5\uC5D0 \uCC38\uD638, \uC8FC\uD0DD,
    \uD30C\uAD34\uB41C \uCC28\uB7C9 \uB4F1 \uC9C0\uD615 \uC694\uC18C\uB97C \uB354
    \uCD94\uAC00\uD558\uACE0 \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4.  \n\uD558\uC9C0\uB9CC
    \uC774 \uB9F5\uC5D0 \uC801\uD569\uD55C \uBB34\uB8CC \uBAA8\uB378\uC744 \uCC3E\uC744
    \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.  \n\uC774 \uB9F5\uC740 \uCE58\uD305\uC744
    \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uACF5\uACA9 \uB4DC\uB860\uC774 \uBC30\uCE58\uB418\uAE30
    \uC804\uC5D0 \uBA3C\uC800 \uB4DC\uB860\uC774 \uD50C\uB808\uC774\uC5B4\uB97C \uBC1C\uACAC\uD574\uC57C
    \uD569\uB2C8\uB2E4. AI\uB294 \uD50C\uB808\uC774\uC5B4\uC758 \uC704\uCE58\uB97C
    \uC54C\uC9C0 \uBABB\uD569\uB2C8\uB2E4. AI\uB294 \uD604\uC2E4\uC801\uC73C\uB85C
    \uD50C\uB808\uC774\uC5B4\uB97C \uC218\uC0C9\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n\uB9C8\uC9C0\uB9C9\uC73C\uB85C,
    \uC800\uB294 Claude AI\uC640 \uD568\uAED8 \uBC14\uC774\uBE0C \uCF54\uB529\uC744
    \uD558\uB294 \uAC83\uC744 \uC815\uB9D0 \uC88B\uC544\uD569\uB2C8\uB2E4."
