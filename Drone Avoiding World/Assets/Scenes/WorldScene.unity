  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u0456\u0442\u0430\u044E! \u0412\u0438 \u0434\u0456\u0441\u0442\u0430\u043B\u0438\u0441\u044F
    \u043C\u0456\u0441\u0446\u044F \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F!\n\u042F
    \u0441\u0442\u0432\u043E\u0440\u0438\u0432 \u0446\u0435\u0439 \u0441\u0432\u0456\u0442
    \u0443 VRChat, \u0431\u043E \u0445\u043E\u0442\u0456\u0432 \u0443 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E\u043C\u0443
    \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0456, \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
    VR, \u0432\u0456\u0434\u0447\u0443\u0442\u0438, \u044F\u043A \u0446\u0435 \u2014
    \u0432\u0435\u0441\u0442\u0438 \u0432\u0456\u0439\u043D\u0443 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
    \u0434\u0440\u043E\u043D\u0456\u0432.\n\u0417\u0430\u0433\u0430\u043B\u043E\u043C,
    \u044F \u0432\u0432\u0430\u0436\u0430\u044E, \u0449\u043E \u0432\u0456\u0439\u043D\u0430
    \u0434\u0440\u043E\u043D\u0456\u0432 \u2014 \u0446\u0435 \u043F\u0435\u043A\u043B\u043E.
    \u0410\u043B\u0435, \u0437\u0440\u0435\u0448\u0442\u043E\u044E, \u0441\u0430\u043C\u0430
    \u0432\u0456\u0439\u043D\u0430 \u2014 \u0446\u0435 \u043F\u0435\u043A\u043B\u043E.\n"
