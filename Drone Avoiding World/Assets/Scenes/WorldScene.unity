--- !u!114 &584312136
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 584312134}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u043C\u0435\u0440
    \u043A\u0430\u0440\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
    500 \xD7 500 \u043C, \u043D\u043E \u044F \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E
    \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0440,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0442\u0435\u043F\u0435\u0440\u044C
    \u043E\u043D \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 100
    \xD7 100 \u043C.\n\u042F \u0445\u043E\u0442\u0435\u043B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
    \u043D\u0430 \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0443 \u0431\u043E\u043B\u044C\u0448\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442\u0430,
    \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A \u0442\u0440\u0430\u043D\u0448\u0435\u0438,
    \u0434\u043E\u043C\u0430 \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043D\u0430\u044F
    \u0442\u0435\u0445\u043D\u0438\u043A\u0430.\n\u041E\u0434\u043D\u0430\u043A\u043E
    \u044F \u043D\u0435 \u0441\u043C\u043E\u0433 \u043D\u0430\u0439\u0442\u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435
    \u043C\u043E\u0434\u0435\u043B\u0438, \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0435
    \u0434\u043B\u044F \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u044B.\n\u041D\u0430
    \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u0435 \u043D\u0435\u0442 \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u044B\u0445
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432. \u0414\u0440\u043E\u043D
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u043E\u043B\u0436\u0435\u043D
    \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u0430,
    \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0431\u0443\u0434\u0435\u0442
    \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u043A\u0430\u043A\u043E\u0439-\u043B\u0438\u0431\u043E
    \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u0439 \u0434\u0440\u043E\u043D.
    \u0418\u0418 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0438\u0433\u0440\u043E\u043A.
    \u0418\u0418 \u0434\u043E\u043B\u0436\u0435\u043D \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E
    \u0438\u0441\u043A\u0430\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u043E\u0432.\n\n\u0418
    \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u044F \u043E\u0431\u043E\u0436\u0430\u044E
    \u0432\u0430\u0439\u0431-\u043A\u043E\u0434\u0438\u043D\u0433 \u0441 Claude AI."
