--- !u!114 &1733653750
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1733653748}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u0445\u043E\u0434\u0435 \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0433\u043E
    \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F \u0432 \u0423\u043A\u0440\u0430\u0438\u043D\u0443
    \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0442\u0438\u043F\u043E\u0432
    \u0434\u0440\u043E\u043D\u043E\u0432.\n\u041D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0435 \u0438\u0437 \u043D\u0438\u0445
    \u2014 FPV-\u0434\u0440\u043E\u043D\u044B-\u043A\u0430\u043C\u0438\u043A\u0430\u0434\u0437\u0435
    \u0438 \u0434\u0440\u043E\u043D\u044B-\u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0438.\n\u041D\u0430
    \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u0435 \u044F \u0441\u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    8-\u0434\u044E\u0439\u043C\u043E\u0432\u044B\u0439 FPV-\u0434\u0440\u043E\u043D-\u043A\u0430\u043C\u0438\u043A\u0430\u0434\u0437\u0435
    (\u044F \u043D\u0430\u0437\u044B\u0432\u0430\u044E \u0435\u0433\u043E \xAB\u041F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB)
    \u0438 10-\u0434\u044E\u0439\u043C\u043E\u0432\u044B\u0439 \u0434\u0440\u043E\u043D-\u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u0449\u0438\u043A
    (\xAB\u0421\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0442\u0435\u043B\u044C\xBB).
    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u043C\u043D\u043E\u0439
    \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0434\u0440\u043E\u043D \u0441 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u043C
    \u043A\u0440\u044B\u043B\u043E\u043C (\xAB\u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C\xBB)
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439
    \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u043F\u0440\u043E\u0441\u0442\u0443\u044E
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E \u0438\u0437
    \u0431\u043B\u043E\u043A\u043E\u0432.\n\u042F \u043F\u043E\u0434\u0443\u043C\u044B\u0432\u0430\u044E
    \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435
    \u0442\u0438\u043F\u043E\u0432 \u0434\u0440\u043E\u043D\u043E\u0432: \u0434\u0440\u043E\u043D\u044B,
    \u043E\u0436\u0438\u0434\u0430\u044E\u0449\u0438\u0435 \u0437\u0430\u0441\u0430\u0434\u044B
    (\xAB\u0412\u044B\u0436\u0438\u0434\u0430\u0442\u0435\u043B\u044C\xBB), \u0434\u0440\u043E\u043D\u044B-\u043A\u0430\u043C\u0438\u043A\u0430\u0434\u0437\u0435
    \u0441 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u043C \u043A\u0440\u044B\u043B\u043E\u043C
    (\xAB\u041A\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\xBB) \u0438 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440-\u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A
    (\xAB\u041F\u0430\u0440\u0438\u0442\u0435\u043B\u044C\xBB).\n\u041E\u0434\u043D\u0430\u043A\u043E
    \u044F \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E
    VRChat \u0441\u043C\u043E\u0436\u0435\u0442 \u0441 \u044D\u0442\u0438\u043C \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F.\n\u041A\u0441\u0442\u0430\u0442\u0438,
    \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0431\u043E\u0435\u0432\u044B\u0435
    \u0434\u0440\u043E\u043D\u044B \u043B\u0435\u0442\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
