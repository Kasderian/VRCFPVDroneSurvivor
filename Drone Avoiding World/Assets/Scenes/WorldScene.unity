--- !u!114 &1066521299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1066521297}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 35630e38b4e5ffb40b44ec5348b4333f, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E! \u0412\u044B
    \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0434\u043E \u043C\u0435\u0441\u0442\u0430
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F!\n\u042F \u0441\u043E\u0437\u0434\u0430\u043B
    \u044D\u0442\u043E\u0442 \u043C\u0438\u0440 \u0432 VRChat, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C,
    \u043A\u0430\u043A\u043E\u0432\u043E \u044D\u0442\u043E \u2014 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0432\u043E\u0439\u043D\u0435 \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u0434\u0440\u043E\u043D\u043E\u0432 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
    \u0441\u0440\u0435\u0434\u0435 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C
    VR.\n\u0412 \u0446\u0435\u043B\u043E\u043C \u044F \u0434\u0443\u043C\u0430\u044E,
    \u0447\u0442\u043E \u0432\u043E\u0439\u043D\u0430 \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u0434\u0440\u043E\u043D\u043E\u0432 \u2014 \u044D\u0442\u043E \u0430\u0434.
    \u041D\u043E, \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
    \u0441\u0430\u043C\u0430 \u0432\u043E\u0439\u043D\u0430 \u2014 \u0442\u043E\u0436\u0435
    \u0430\u0434.\n"
